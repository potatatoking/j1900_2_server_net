#!/bin/sh
# The campus /17 overlaps Docker's default 172.20.0.0/16 bridge.
# A more specific route sends campus replies through the LAN router.
[ "${IFACE:-}" = "enp3s0" ] || exit 0
[ "${ADDRFAM:-}" = "inet" ] || exit 0

ip -4 route replace 172.20.128.0/17 via 10.42.0.1 dev enp3s0 proto static metric 50
