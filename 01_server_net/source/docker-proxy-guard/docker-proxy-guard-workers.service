[Unit]
Description=Transparent proxy workers for selected Docker namespaces
Requires=docker.service docker-proxy-guard.service
After=docker.service docker-proxy-guard.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/docker-proxy-guard/daemon.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
